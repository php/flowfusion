--TEST--
Translated seed (inferredbugs-csharp: poderosa/3)
--FILE--
<?php
$w = fopen('php://stdout', 'w');
$hex = '';
$prime = gmp_init($hex, 16);
$base = gmp_init(2);
$x = gmp_init(bin2hex(random_bytes(32)), 16);
$e = gmp_powm($base, $x, $prime);
$f = gmp_powm($base, gmp_add($x, 1), $prime);
$k = gmp_powm($f, $x, $prime);
$h1 = hash('sha1', gmp_export($e) . gmp_export($f) . gmp_export($k), true);
$h2 = hash('sha256', $h1 . gmp_export($prime), true);
fwrite($w, substr(bin2hex($h1), 0, 40) . "\n");
fwrite($w, substr(bin2hex($h2), 0, 64) . "\n");
?>
--EXPECT--
