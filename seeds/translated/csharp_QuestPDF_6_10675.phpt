--TEST--
Translated seed (inferredbugs-csharp: QuestPDF/6)
--FILE--
<?php
$cases = [
    [[500, 5, 'u'], [[500, 5, 'u'], [500, 4, 'u'], [500, 3, 'u'], [500, 6, 'u']]],
    [[500, 6, 'u'], [[500, 6, 'u'], [500, 7, 'u'], [500, 8, 'u'], [500, 5, 'u']]],
    [[500, 5, 'i'], [[500, 5, 'i'], [500, 5, 'o'], [500, 5, 'u']]],
    [[500, 5, 'o'], [[500, 5, 'o'], [500, 5, 'i'], [500, 5, 'u']]],
    [[500, 5, 'u'], [[500, 5, 'u'], [500, 5, 'o'], [500, 5, 'i']]],
    [[300, 5, 'u'], [[300, 5, 'u'], [200, 5, 'u'], [100, 5, 'u'], [400, 5, 'u']]],
    [[400, 5, 'u'], [[500, 5, 'u'], [300, 5, 'u'], [100, 5, 'u'], [600, 5, 'u']]],
    [[600, 5, 'u'], [[600, 5, 'u'], [700, 5, 'u'], [800, 5, 'u'], [500, 5, 'u']]],
    [[500, 5, 'u'], [[600, 5, 'i'], [600, 6, 'u'], [500, 6, 'i']]],
];

foreach ($cases as [$target, $styles]) {
    for ($i = 0, $n = count($styles) - 1; $i < $n; $i++) {
        [$w1, $wd1, $s1] = $styles[$i];
        [$w2, $wd2, $s2] = $styles[$i + 1];
        $d1 = abs($target[0] - $w1) + abs($target[1] - $wd1) + ($target[2] !== $s1 ? 1 : 0);
        $d2 = abs($target[0] - $w2) + abs($target[1] - $wd2) + ($target[2] !== $s2 ? 1 : 0);
        if (!($d1 <= $d2)) exit(1);
        if (!($d2 <= $d1)) exit(1);
    }
}
?>
--EXPECT--
