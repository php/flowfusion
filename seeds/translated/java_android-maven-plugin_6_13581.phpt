--TEST--
Translated seed (inferredbugs-java: android-maven-plugin/6)
--FILE--
<?php

$includeDirectories = [];
$outputDir = '/tmp'; // Simulate a temporary output directory
$artifacts = [
    [
        'groupId' => 'com.example',
        'artifactId' => 'example-lib',
        'type' => 'a',
        'version' => '1.0.0',
        'file' => 'example-lib.a',
    ]
];

$makeFile = "# Generated by Android Maven Plugin\n";

foreach ($artifacts as $artifact) {
    $makeFile .= "#\n";
    $makeFile .= "# Group ID: " . $artifact['groupId'] . "\n";
    $makeFile .= "# Artifact ID: " . $artifact['artifactId'] . "\n";
    $makeFile .= "# Artifact Type: " . $artifact['type'] . "\n";
    $makeFile .= "# Version: " . $artifact['version'] . "\n";
    $makeFile .= "include \$(CLEAR_VARS)\n";
    $makeFile .= "LOCAL_MODULE    := " . $artifact['artifactId'] . "\n";

    $localPath = resolveRelativePath($outputDir, $artifact['file']);
    $makeFile .= "LOCAL_PATH := " . dirname($localPath) . "\n";
    $makeFile .= "LOCAL_SRC_FILES := " . basename($artifact['file']) . "\n";
    $makeFile .= "LOCAL_MODULE_FILENAME := " . pathinfo($artifact['file'], PATHINFO_FILENAME) . "\n";

    if ($artifact['type'] === 'a') {
        $makeFile .= "include \$(PREBUILT_STATIC_LIBRARY)\n";
    } else {
        $makeFile .= "include \$(PREBUILT_SHARED_LIBRARY)\n";
    }
}

file_put_contents('/tmp/Makefile', $makeFile);

function resolveRelativePath($outputDirectory, $file) {
    $resolvedPath = realpath($file);
    $strOutputDirectoryPath = realpath($outputDirectory);
    $strFilePath = realpath($file);

    if (strpos($strFilePath, $strOutputDirectoryPath) === 0) {
        $resolvedPath = substr($strFilePath, strlen($strOutputDirectoryPath) + 1);
    } else {
        throw new Exception("Unable to resolve relative path across directories.");
    }
    
    return $resolvedPath;
}
--EXPECT--
